// =====================================================================
//  GCH Moda — Tienda online, gestión, CRM y blog para boutiques en Venezuela
//  Multi-negocio (cada boutique es un Tenant). Ver docs/ARQUITECTURA.md.
//
//  Reglas de dinero:
//  - Los precios del catálogo se guardan en USD (moneda de referencia).
//  - El bolívar (VES) es la moneda de cuenta: cada pedido guarda la tasa
//    BCV del momento y sus montos en VES para el libro de ventas.
//  - Cada pago se guarda en SU moneda original (VES, USD o USDT) con la
//    tasa usada y sus equivalentes en USD y en VES (a tasa BCV).
// =====================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Roles del personal. TENANT_ADMIN = dueña; BRANCH_ADMIN = encargada de tienda;
/// SELLER = vendedora/caja; EDITOR = contenido (blog, banners).
enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  BRANCH_ADMIN
  SELLER
  EDITOR
}

enum Currency {
  VES
  USD
  USDT
}

/// Origen de la tasa: BCV (oficial, la de los libros) o P2P (mercado, solo gestión).
enum RateSource {
  BCV
  P2P
}

/// Cédula/RIF venezolano: V (venezolano), E (extranjero), J (jurídico), G (gobierno), P (pasaporte), C (comuna).
enum IdType {
  V
  E
  J
  G
  P
  C
}

enum TaxMode {
  /// El precio ya incluye el IVA (lo más común en boutiques)
  PRICE_INCLUDES_TAX
  /// El IVA se suma al precio
  TAX_ADDED
}

enum Gender {
  WOMEN
  MEN
  UNISEX
  KIDS
}

enum SizeKind {
  CLOTHING
  SHOE
  ONE_SIZE
  OTHER
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  RESERVATION_RELEASE
}

enum OrderChannel {
  WEB
  STORE
  WHATSAPP
  INSTAGRAM
}

enum OrderStatus {
  /// Pedido creado, falta el pago
  PENDING
  /// Pago reportado por el cliente, por verificar
  PAYMENT_REVIEW
  /// Pago confirmado
  PAID
  PREPARING
  /// Listo para retirar o enviado
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum FulfillmentType {
  /// Retiro en tienda
  PICKUP
  /// Delivery en la ciudad
  LOCAL_DELIVERY
  /// Envío nacional por encomienda (MRW, Zoom, Tealca, Domesa…)
  NATIONAL_SHIPPING
}

enum PaymentMethod {
  PAGO_MOVIL
  TRANSFER_VES
  /// Punto de venta (tarjeta de débito/crédito en bolívares)
  POS_CARD
  CASH_VES
  CASH_USD
  ZELLE
  TRANSFER_USD
  /// USDT por Binance Pay u otra billetera
  USDT
}

enum PaymentRecordStatus {
  /// Reportado por el cliente, falta verificar en la cuenta
  PENDING_REVIEW
  CONFIRMED
  REJECTED
  REFUNDED
}

enum FinancialAccountType {
  BANK_VES
  PAGO_MOVIL
  POS_TERMINAL
  CASH_VES
  CASH_USD
  ZELLE
  BANK_USD
  CRYPTO_USDT
}

/// Documentos fiscales. DELIVERY_NOTE (nota de entrega) no es fiscal.
enum InvoiceType {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  DELIVERY_NOTE
}

enum InvoiceStatus {
  ISSUED
  VOIDED
}

/// Cómo se obtiene el número de control: lo asigna una imprenta digital
/// autorizada por el SENIAT, o viene de formatos preimpresos (forma libre).
enum ControlNumberMode {
  DIGITAL_PRINTER
  FREE_FORM
  NONE
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
}

enum CustomerSource {
  STORE
  WEB
  INSTAGRAM
  WHATSAPP
  REFERRAL
  OTHER
}

enum InteractionType {
  NOTE
  CALL
  WHATSAPP
  INSTAGRAM
  VISIT
  EMAIL
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

// ───────────────────────────── Plataforma ─────────────────────────────

model Tenant {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  /// Razón social y RIF del emisor (salen en la factura)
  legalName     String?
  rif           String?
  fiscalAddress String?
  status        TenantStatus @default(ACTIVE)
  tagline       String?
  contactEmail  String?
  /// WhatsApp de atención (+58…)
  contactPhone  String?
  instagram     String?

  // Identidad visual (ver src/lib/theme.ts)
  logoUrl         String?
  primaryColor    String  @default("#7B2F9E")
  themeBackground String?
  themeSurface    String?
  themeText       String?
  themeBar        String?
  themeAccent     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings          TenantSettings?
  domains           TenantDomain[]
  branches          Branch[]
  memberships       Membership[]
  assets            TenantAsset[]
  categories        Category[]
  sizes             Size[]
  colors            Color[]
  brands            Brand[]
  products          Product[]
  exchangeRates     ExchangeRate[]
  financialAccounts FinancialAccount[]
  customers         Customer[]
  customerTags      CustomerTag[]
  orders            Order[]
  invoiceSeries     InvoiceSeries[]
  invoices          Invoice[]
  promoBanners      PromoBanner[]
  heroCards         HeroCard[]
  blogCategories    BlogCategory[]
  blogPosts         BlogPost[]
  auditLogs         AuditLog[]

  @@map("tenants")
}

model TenantDomain {
  id       String @id @default(cuid())
  tenantId String
  domain   String @unique

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

/// Configuración fiscal, de moneda y de tienda de cada boutique.
model TenantSettings {
  id       String @id @default(cuid())
  tenantId String @unique

  // ── Impuestos (Venezuela) ──
  /// Interruptor global del IVA (cada producto puede además ser exento).
  ivaEnabled        Boolean @default(true)
  ivaRate           Decimal @default(0.16) @db.Decimal(5, 4)
  taxMode           TaxMode @default(PRICE_INCLUDES_TAX)
  /// Contribuyente especial designado por el SENIAT (afecta IGTF y retenciones).
  isSpecialTaxpayer Boolean @default(false)
  /// IGTF sobre pagos en divisas o cripto (3 %). Solo si aplica al negocio.
  igtfEnabled       Boolean @default(false)
  igtfRate          Decimal @default(0.03) @db.Decimal(5, 4)

  // ── Moneda ──
  /// Tasa con la que se muestran los precios en bolívares en la tienda.
  displayRateSource RateSource @default(BCV)
  /// Mostrar también el precio en Bs en la tienda.
  showVesPrices     Boolean    @default(true)

  // ── Tienda ──
  freeShippingFromUsd Decimal? @db.Decimal(12, 2)
  /// Días que se considera "Nuevo" un producto.
  newProductDays      Int      @default(30)
  /// Stock en o por debajo del cual se avisa "¡Últimas unidades!".
  lowStockThreshold   Int      @default(3)
  /// Reservar el stock de un pedido web sin pagar durante estas horas.
  reservationHours    Int      @default(24)

  // ── Entrega (checkout web) ──
  pickupEnabled           Boolean  @default(true)
  /// Dirección y horario para retirar (se muestra en el checkout)
  pickupInfo              String?
  localDeliveryEnabled    Boolean  @default(true)
  localDeliveryUsd        Decimal? @default(3) @db.Decimal(12, 2)
  /// Zona que cubre el delivery: "Acarigua y Araure"
  localDeliveryArea       String?
  nationalShippingEnabled Boolean  @default(true)
  /// Costo del envío nacional; vacío = cobro a destino (lo paga el cliente en la agencia)
  nationalShippingUsd     Decimal? @db.Decimal(12, 2)

  /// Próximo número visible de pedido (#1001). Se incrementa dentro de la transacción.
  nextOrderNumber Int @default(1001)

  // ── CRM: segmentación automática ──
  vipMinSpentUsd     Decimal @default(500) @db.Decimal(12, 2)
  recurrentMinOrders Int     @default(3)
  inactiveAfterDays  Int     @default(90)

  timezone      String   @default("America/Caracas")
  receiptFooter String?  @default("¡Gracias por tu compra!")
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Tienda física (o almacén). La mayoría de boutiques tiene una sola.
model Branch {
  id           String  @id @default(cuid())
  tenantId     String
  name         String
  slug         String
  address      String?
  city         String?
  state        String?
  phone        String?
  isActive     Boolean @default(true)
  /// Se puede retirar aquí los pedidos web
  allowsPickup Boolean @default(true)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  orders        Order[]
  cashRegisters CashRegister[]

  @@unique([tenantId, slug])
  @@map("branches")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  sessions         Session[]
  ordersCreated    Order[]               @relation("OrderCreatedBy")
  paymentsReviewed Payment[]             @relation("PaymentReviewedBy")
  stockMovements   StockMovement[]
  cashSessions     CashSession[]         @relation("CashOpenedBy")
  cashClosed       CashSession[]         @relation("CashClosedBy")
  ratesCreated     ExchangeRate[]
  interactions     CustomerInteraction[]
  posts            BlogPost[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Membership {
  id       String  @id @default(cuid())
  userId   String
  tenantId String
  /// null = todas las tiendas del negocio
  branchId String?
  role     Role
  isActive Boolean @default(true)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Límite de intentos (login, formularios públicos).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@map("rate_limits")
}

/// Imágenes subidas por el negocio (logo, productos, banners, blog), servidas en /marca/<clave>.
model TenantAsset {
  id        String   @id @default(cuid())
  tenantId  String
  kind      String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind])
  @@map("tenant_assets")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────── Tasas de cambio ───────────────────────────

/// Histórico de tasas (Bs por 1 USD). La vigente es la más reciente de cada fuente.
model ExchangeRate {
  id          String     @id @default(cuid())
  tenantId    String
  source      RateSource
  /// Bolívares por 1 dólar
  rate        Decimal    @db.Decimal(18, 6)
  /// Desde cuándo rige (la BCV se publica para el día hábil siguiente)
  effectiveAt DateTime
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, source, effectiveAt])
  @@map("exchange_rates")
}

// ───────────────────────────── Catálogo ─────────────────────────────

model Category {
  id             String  @id @default(cuid())
  tenantId       String
  parentId       String?
  name           String
  slug           String
  description    String?
  imageUrl       String?
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)
  seoTitle       String?
  seoDescription String?

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@map("categories")
}

/// Tallas del negocio: S, M, L, XL… o números de calzado 35–41.
model Size {
  id        String   @id @default(cuid())
  tenantId  String
  label     String
  kind      SizeKind
  sortOrder Int      @default(0)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([tenantId, kind, label])
  @@map("sizes")
}

/// Colores con su muestra para los "puntos de color" de la tienda.
model Color {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  hex       String
  sortOrder Int    @default(0)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  images   ProductImage[]

  @@unique([tenantId, name])
  @@map("colors")
}

model Brand {
  id       String @id @default(cuid())
  tenantId String
  name     String

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@map("brands")
}

model Product {
  id          String  @id @default(cuid())
  tenantId    String
  categoryId  String
  brandId     String?
  name        String
  slug        String
  description String?
  /// Material, cuidados, medidas…
  details     String?
  gender      Gender  @default(WOMEN)

  /// Precio de venta en USD (los Bs se calculan con la tasa vigente).
  priceUsd       Decimal  @db.Decimal(12, 2)
  /// Precio "antes" tachado (promoción)
  compareAtUsd   Decimal? @db.Decimal(12, 2)
  /// Costo de compra (para margen)
  costUsd        Decimal? @db.Decimal(12, 2)
  /// Exento de IVA (además del interruptor global)
  ivaExempt      Boolean  @default(false)
  freeShipping   Boolean  @default(false)
  /// Etiqueta manual: "Promoción", "Colección Verano"…
  badge          String?
  tags           String[]
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  sortOrder      Int      @default(0)
  publishedAt    DateTime @default(now())
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category          @relation(fields: [categoryId], references: [id])
  brand      Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  blogLinks  BlogPostProduct[]

  @@unique([tenantId, slug])
  @@index([tenantId, categoryId, isActive])
  @@map("products")
}

/// Fotos verticales (3:4). La de orden 0 es la principal; la 1 se ve al pasar el mouse.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  /// Foto de un color específico (al elegir el color, se muestra esta)
  colorId   String?
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Combinación talla + color con su propio stock y SKU.
model ProductVariant {
  id               String   @id @default(cuid())
  tenantId         String
  productId        String
  sizeId           String?
  colorId          String?
  sku              String
  barcode          String?
  /// Precio distinto para esta variante (vacío = el del producto)
  priceUsdOverride Decimal? @db.Decimal(12, 2)
  stock            Int      @default(0)
  /// Unidades apartadas por pedidos web sin pagar
  reserved         Int      @default(0)
  isActive         Boolean  @default(true)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       Size?           @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color      Color?          @relation(fields: [colorId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  movements  StockMovement[]

  @@unique([tenantId, sku])
  @@unique([productId, sizeId, colorId])
  @@index([productId])
  @@map("product_variants")
}

model StockMovement {
  id         String            @id @default(cuid())
  tenantId   String
  variantId  String
  type       StockMovementType
  /// + entrada / − salida
  quantity   Int
  stockAfter Int
  reason     String?
  orderId    String?
  userId     String?
  createdAt  DateTime          @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([variantId, createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────── CRM ───────────────────────────────

model Customer {
  id             String         @id @default(cuid())
  tenantId       String
  firstName      String
  lastName       String?
  idType         IdType?
  /// Número de cédula o RIF sin letra ni guiones
  idNumber       String?
  phone          String?
  whatsapp       String?
  email          String?
  instagram      String?
  birthday       DateTime?      @db.Date
  source         CustomerSource @default(STORE)
  /// Notas internas (no las ve el cliente)
  notes          String?
  marketingOptIn Boolean        @default(false)
  /// Mayorista: precios y condiciones especiales (etiqueta manual)
  isWholesale    Boolean        @default(false)

  // Métricas (se recalculan al confirmar o anular un pedido)
  ordersCount           Int            @default(0)
  totalSpentUsd         Decimal        @default(0) @db.Decimal(14, 2)
  totalSpentVes         Decimal        @default(0) @db.Decimal(18, 2)
  firstOrderAt          DateTime?
  lastOrderAt           DateTime?
  lastInteractionAt     DateTime?
  /// Método de pago más usado (calculado)
  favoritePaymentMethod PaymentMethod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses    CustomerAddress[]
  tags         CustomerTagOnCustomer[]
  interactions CustomerInteraction[]
  orders       Order[]

  @@unique([tenantId, phone])
  @@index([tenantId, idNumber])
  @@index([tenantId, lastOrderAt])
  @@map("customers")
}

model CustomerAddress {
  id             String  @id @default(cuid())
  customerId     String
  label          String? // "Casa", "Trabajo"
  state          String
  city           String
  municipality   String?
  line           String
  reference      String?
  /// Oficina de encomienda preferida (MRW, Zoom…)
  shippingOffice String?
  isDefault      Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

/// Etiquetas del CRM. Las automáticas (VIP, Recurrente, Nuevo, Inactivo) las pone el sistema.
model CustomerTag {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  color    String  @default("#7B2F9E")
  /// Clave de la regla automática: VIP | RECURRENT | NEW | INACTIVE (null = manual)
  autoRule String?

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers CustomerTagOnCustomer[]

  @@unique([tenantId, name])
  @@map("customer_tags")
}

model CustomerTagOnCustomer {
  customerId String
  tagId      String
  assignedAt DateTime @default(now())

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tag_assignments")
}

/// Seguimiento del cliente: notas, llamadas, mensajes, visitas.
model CustomerInteraction {
  id         String          @id @default(cuid())
  customerId String
  type       InteractionType
  body       String
  userId     String?
  createdAt  DateTime        @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("customer_interactions")
}

// ─────────────────────── Cuentas y pagos ───────────────────────

/// Cuentas donde entra el dinero: Banesco Pago Móvil, Mercantil, Caja chica USD, Binance…
model FinancialAccount {
  id             String               @id @default(cuid())
  tenantId       String
  name           String
  type           FinancialAccountType
  currency       Currency
  bankName       String?
  /// Código del banco (0102, 0134…) para Pago Móvil y transferencias
  bankCode       String?
  accountNumber  String?
  holderName     String?
  holderIdType   IdType?
  holderIdNumber String?
  /// Teléfono del Pago Móvil
  phone          String?
  /// Correo de Zelle
  email          String?
  /// ID o correo de Binance Pay
  walletId       String?
  /// Se muestra al cliente en el checkout con sus datos
  showInCheckout Boolean              @default(true)
  isActive       Boolean              @default(true)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments      Payment[]
  cashMovements CashMovement[]
  closingLines  CashClosingLine[]

  @@index([tenantId, isActive])
  @@map("financial_accounts")
}

// ─────────────────────────── Pedidos ───────────────────────────

model Order {
  id             String          @id @default(cuid())
  tenantId       String
  branchId       String?
  /// Número visible y correlativo por negocio (#1024)
  number         Int
  /// Idempotencia (reintentos no duplican el pedido)
  idempotencyKey String?         @unique
  /// Token público para el seguimiento sin cuenta
  trackingToken  String          @unique @default(cuid())
  channel        OrderChannel
  status         OrderStatus     @default(PENDING)
  paymentStatus  PaymentStatus   @default(UNPAID)
  fulfillment    FulfillmentType @default(PICKUP)

  // Cliente (copia al momento del pedido)
  customerId       String?
  customerName     String
  customerIdType   IdType?
  customerIdNumber String?
  customerPhone    String?
  customerEmail    String?

  // Entrega
  shippingState   String?
  shippingCity    String?
  shippingAddress String?
  shippingRef     String?
  /// MRW, Zoom, Tealca, Domesa…
  carrier         String?
  carrierOffice   String?
  trackingNumber  String?

  // Montos en USD (moneda de precio)
  subtotalUsd Decimal @db.Decimal(12, 2)
  discountUsd Decimal @default(0) @db.Decimal(12, 2)
  taxableUsd  Decimal @default(0) @db.Decimal(12, 2)
  exemptUsd   Decimal @default(0) @db.Decimal(12, 2)
  ivaRate     Decimal @db.Decimal(5, 4)
  ivaUsd      Decimal @default(0) @db.Decimal(12, 2)
  shippingUsd Decimal @default(0) @db.Decimal(12, 2)
  /// IGTF cobrado por pagos en divisas (equivalente en USD) y la parte del total pagada en divisas (su base)
  igtfUsd     Decimal @default(0) @db.Decimal(12, 2)
  igtfBaseUsd Decimal @default(0) @db.Decimal(12, 2)
  totalUsd    Decimal @db.Decimal(12, 2)
  /// Tasa BCV al crear el pedido (Bs por USD) y total en Bs a esa tasa
  bcvRate     Decimal @db.Decimal(18, 6)
  totalVes    Decimal @db.Decimal(18, 2)
  paidUsd     Decimal @default(0) @db.Decimal(12, 2)

  notes           String?
  internalNote    String?
  createdById     String?
  cashSessionId   String?
  /// Hasta cuándo se aparta el stock si no paga
  reservedUntil   DateTime?
  termsAcceptedAt DateTime?

  paidAt       DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cashSession CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    Payment[]
  invoices    Invoice[]
  movements   StockMovement[]
  events      OrderEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  // Copia al momento de la venta
  productName  String
  sku          String?
  sizeLabel    String?
  colorName    String?
  quantity     Int
  unitPriceUsd Decimal @db.Decimal(12, 2)
  discountUsd  Decimal @default(0) @db.Decimal(12, 2)
  /// 0 si es exento
  ivaRate      Decimal @db.Decimal(5, 4)
  lineBaseUsd  Decimal @db.Decimal(12, 2)
  lineIvaUsd   Decimal @db.Decimal(12, 2)
  lineTotalUsd Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

/// Historial del pedido: cambios de estado, pagos y notas (lo ve el personal).
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  note       String?
  /// Quién lo hizo (vacío = el cliente o el sistema)
  userId     String?
  userName   String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Un pago (un pedido puede tener varios: parte en Bs y parte en USD).
model Payment {
  id                 String              @id @default(cuid())
  tenantId           String
  orderId            String
  method             PaymentMethod
  status             PaymentRecordStatus @default(PENDING_REVIEW)
  /// Moneda y monto ORIGINAL en que se pagó
  currency           Currency
  amount             Decimal             @db.Decimal(18, 2)
  /// Tasa usada para convertir (Bs por USD). En VES: la BCV del día; en USDT: P2P si aplica.
  rate               Decimal             @db.Decimal(18, 6)
  rateSource         RateSource          @default(BCV)
  /// Equivalentes para reportes (USD) y libros (VES a tasa BCV)
  amountUsd          Decimal             @db.Decimal(12, 2)
  amountVes          Decimal             @db.Decimal(18, 2)
  /// IGTF de este pago (en la moneda del pago). El pago trae el IGTF incluido: abona al pedido amountUsd − igtfAmount.
  igtfAmount         Decimal             @default(0) @db.Decimal(18, 2)
  /// Parte del pago que cubre el pedido y sobre la que se calculó el IGTF
  igtfBase           Decimal             @default(0) @db.Decimal(18, 2)
  financialAccountId String?
  /// Número de referencia (Pago Móvil, transferencia, hash de USDT)
  reference          String?
  payerName          String?
  payerIdNumber      String?
  payerPhone         String?
  payerBank          String?
  /// Captura del comprobante (clave en TenantAsset)
  proofKey           String?
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNote         String?
  cashSessionId      String?
  createdAt          DateTime            @default(now())

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  reviewedBy       User?             @relation("PaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  cashSession      CashSession?      @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([orderId])
  @@index([financialAccountId, createdAt])
  @@map("payments")
}

// ─────────────────────── Facturación (Venezuela) ───────────────────────

/// Serie de numeración de facturas, notas de crédito/débito o notas de entrega.
model InvoiceSeries {
  id            String            @id @default(cuid())
  tenantId      String
  type          InvoiceType
  /// Serie (vacío o "A", "B"…)
  series        String            @default("")
  nextNumber    Int               @default(1)
  controlMode   ControlNumberMode @default(NONE)
  /// Forma libre: rango de números de control preimpresos
  controlPrefix String?
  nextControl   Int?
  controlTo     Int?
  isActive      Boolean           @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([tenantId, type, series])
  @@map("invoice_series")
}

/// Factura / nota emitida. Los montos fiscales van en Bs a tasa BCV del día de emisión,
/// con el equivalente en USD y la tasa (exigido cuando la operación es en divisas).
model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  orderId       String
  seriesId      String
  type          InvoiceType
  number        Int
  /// Número de control (imprenta digital autorizada o formato preimpreso)
  controlNumber String?
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())

  // Comprador
  buyerName     String
  buyerIdType   IdType?
  buyerIdNumber String?
  buyerAddress  String?
  buyerPhone    String?
  buyerEmail    String?

  /// Renglones (copia fija: descripción, cantidad, precio y base en Bs, exento). Ver src/lib/invoicing.ts
  lines         Json    @default("[]")
  /// Motivo de la nota de crédito o débito
  concept       String?
  createdByName String?

  // Montos en Bs (libro de ventas)
  bcvRate     Decimal @db.Decimal(18, 6)
  taxableVes  Decimal @db.Decimal(18, 2)
  exemptVes   Decimal @db.Decimal(18, 2)
  ivaRate     Decimal @db.Decimal(5, 4)
  ivaVes      Decimal @db.Decimal(18, 2)
  /// Monto pagado en divisas (base del IGTF) y el IGTF
  igtfBaseVes Decimal @default(0) @db.Decimal(18, 2)
  igtfVes     Decimal @default(0) @db.Decimal(18, 2)
  totalVes    Decimal @db.Decimal(18, 2)
  /// Referencia en USD
  totalUsd    Decimal @db.Decimal(12, 2)

  /// Factura afectada (notas de crédito/débito)
  relatedInvoiceId String?
  voidReason       String?
  voidedAt         DateTime?
  /// Respuesta de la imprenta digital (id externo, PDF…)
  providerData     Json?

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  series  InvoiceSeries @relation(fields: [seriesId], references: [id])
  related Invoice?      @relation("InvoiceNotes", fields: [relatedInvoiceId], references: [id], onDelete: Restrict)
  notes   Invoice[]     @relation("InvoiceNotes")

  @@unique([seriesId, number])
  @@unique([tenantId, controlNumber])
  @@index([tenantId, issuedAt])
  @@index([orderId])
  @@map("invoices")
}

// ─────────────────────────── Caja ───────────────────────────

model CashRegister {
  id       String  @id @default(cuid())
  tenantId String
  branchId String
  name     String
  isActive Boolean @default(true)

  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sessions CashSession[]

  @@map("cash_registers")
}

/// Turno de caja. El cierre se consolida por cuenta y moneda (CashClosingLine).
model CashSession {
  id           String            @id @default(cuid())
  tenantId     String
  registerId   String
  status       CashSessionStatus @default(OPEN)
  openedById   String
  openedAt     DateTime          @default(now())
  /// Fondo inicial por moneda: { "VES": "500.00", "USD": "20.00" }
  openingFloat Json
  closedById   String?
  closedAt     DateTime?
  notes        String?

  register  CashRegister      @relation(fields: [registerId], references: [id], onDelete: Cascade)
  openedBy  User              @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedBy  User?             @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  orders    Order[]
  payments  Payment[]
  movements CashMovement[]
  lines     CashClosingLine[]

  @@index([tenantId, openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id                 String           @id @default(cuid())
  sessionId          String
  type               CashMovementType
  currency           Currency
  amount             Decimal          @db.Decimal(18, 2)
  financialAccountId String?
  reason             String
  /// Quién lo registró
  createdById        String?
  /// Pedido relacionado (p. ej. el vuelto de una venta)
  orderId            String?
  createdAt          DateTime         @default(now())

  session          CashSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)

  @@map("cash_movements")
}

/// Línea del cierre: lo esperado vs. lo contado en cada cuenta y moneda.
model CashClosingLine {
  id                 String   @id @default(cuid())
  sessionId          String
  financialAccountId String?
  currency           Currency
  expected           Decimal  @db.Decimal(18, 2)
  counted            Decimal  @db.Decimal(18, 2)
  difference         Decimal  @db.Decimal(18, 2)
  /// Equivalentes para el resumen consolidado
  expectedUsd        Decimal  @db.Decimal(12, 2)
  expectedVes        Decimal  @db.Decimal(18, 2)

  session          CashSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)

  @@map("cash_closing_lines")
}

// ─────────────────────── Contenido de la tienda ───────────────────────

/// Carrusel principal (promociones del mes).
model PromoBanner {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  imageUrl  String
  linkUrl   String?
  startsAt  DateTime
  endsAt    DateTime
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
  @@map("promo_banners")
}

/// Tarjetas verticales grandes de la portada ("Moda Mujer", "Calzado", "Colección Nueva").
model HeroCard {
  id        String  @id @default(cuid())
  tenantId  String
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("hero_cards")
}

// ─────────────────────────── Blog / Lookbook ───────────────────────────

model BlogCategory {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  sortOrder Int    @default(0)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts  BlogPost[]

  @@unique([tenantId, slug])
  @@map("blog_categories")
}

model BlogPost {
  id             String     @id @default(cuid())
  tenantId       String
  categoryId     String?
  authorId       String?
  title          String
  slug           String
  excerpt        String?
  /// Contenido en Markdown (se muestra con un renderizador seguro, sin HTML crudo)
  content        String
  coverImageUrl  String?
  tags           String[]
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  readingMinutes Int        @default(1)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category BlogCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  products BlogPostProduct[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
  @@map("blog_posts")
}

/// "Consigue este look": productos enlazados a un artículo.
model BlogPostProduct {
  postId    String
  productId String
  sortOrder Int     @default(0)
  note      String?

  post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@map("blog_post_products")
}

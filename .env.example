DATABASE_URL="postgresql://usuario:clave@host/db?sslmode=require"
# Solo local: BD de sombra de "prisma migrate dev"
SHADOW_DATABASE_URL=""
DATABASE_POOL_MAX="5"
# Dominio raíz: en producción, el de la plataforma (ej. gchmoda.com). Subdominio = negocio.
ROOT_DOMAIN="localhost"
# Negocio que se muestra en el dominio raíz y en *.vercel.app
DEFAULT_TENANT_SLUG="sfboutique"
SEED_ADMIN_EMAIL="admin@tu-negocio.com"
SEED_ADMIN_PASSWORD="una-clave-larga-y-unica"

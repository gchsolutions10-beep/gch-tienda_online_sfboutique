{
  "name": "gch-moda",
  "version": "0.1.0",
  "private": true,
  "description": "Tienda online, CRM, blog y gestión para boutiques de moda en Venezuela (GchSolutions)",
  "scripts": {
    "dev": "next dev",
    "push:llaves": "web-push generate-vapid-keys",
    "build": "prisma generate && node scripts/migrar-en-vercel.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:local": "prisma dev --name moda --port 51217 --db-port 51218 --shadow-db-port 51219",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:admin": "tsx prisma/admin.ts",
    "migrar:neon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrar-neon.ps1",
    "demo:neon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/demo-neon.ps1",
    "admin:neon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/admin-neon.ps1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.5",
    "leaflet": "^1.9.4",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
